# ========== DeepSeek 大模型 ==========
# 申请地址: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ========== Milvus 向量库 ==========
# 默认连接本机 docker-compose 启动的 Milvus
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=medical_qa

# ========== Embedding 模型 ==========
# bge-large-zh-v1.5 约 1.3GB, 首次运行自动从 HuggingFace 下载
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
# 设备: cuda / cpu
EMBEDDING_DEVICE=cpu

# ========== 数据库 (MySQL) ==========
# 上传文档元数据存储；首次使用先执行 python scripts/init_db.py 建库
DATABASE_URL=mysql+pymysql://root:你的密码@127.0.0.1:3306/medical_rag?charset=utf8mb4

# ========== 数据路径 ==========
# 医疗问答数据集根目录 (相对 backend 目录)
MEDICAL_DATA_DIR=../Chinese-medical-dialogue-data-master/Data_数据

# ========== 服务 ==========
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# CORS 允许的前端地址
FRONTEND_URL=http://localhost:5173
