# ========== 大模型（OpenAI 兼容接口）==========
# 默认走硅基流动；申请地址: https://cloud.siliconflow.cn/account/ak
LLM_API_KEY=
LLM_BASE_URL=https://api.siliconflow.cn/v1
# 可换任意网关支持的模型；改写与生成共用（改写固定 temperature=0.0）
LLM_MODEL=deepseek-ai/DeepSeek-V4-Flash

# ========== Milvus 向量库 ==========
# 需 Milvus 2.5+（collection 使用 BM25 Function 生成 sparse 字段）
# 默认连接本机 docker-compose 启动的 Milvus
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=medical_qa

# ========== Embedding 模型 ==========
# bge-large-zh-v1.5 约 1.3GB。缓存就绪后强制离线加载（见 app/__init__.py）
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
# 设备: cuda / cpu
EMBEDDING_DEVICE=cpu

# ========== Reranker 模型 ==========
# 模型 id 固定在 app/config.py（BAAI/bge-reranker-v2-m3，约 2GB），
# 经 resolve_hf_snapshot() 解析为本地快照绝对路径后加载，不走网络
RERANKER_DEVICE=cuda
# 精排最终保留条数
RERANKER_TOP_K=5

# ========== 数据库 (MySQL) ==========
# 会话 / 消息 / 上传文档元数据 / 反馈；首次使用先执行 python scripts/init_db.py 建库
DATABASE_URL=mysql+pymysql://root:你的密码@127.0.0.1:3306/medical_rag?charset=utf8mb4

# ========== 数据路径 ==========
# 医疗问答数据集根目录 (相对 backend 目录)
MEDICAL_DATA_DIR=../Chinese-medical-dialogue-data-master/Data_数据
# 清洗后的按科室 JSON 目录 (相对 backend 目录，由 scripts/clean_data.py 生成)
CLEANED_DATA_DIR=data/by_department

# ========== 上传文档 ==========
UPLOAD_DIR=uploads
UPLOAD_MAX_SIZE_MB=100
UPLOAD_ALLOWED_EXTENSIONS=.pdf,.docx,.txt,.md,.csv

# ========== 检索 ==========
QUERY_REWRITE_ENABLED=true
BM25_WEIGHT=0.3
VECTOR_WEIGHT=0.7
# 相关性闸门：rerank 最高分低于阈值 → 判定库中无相关内容
RELEVANCE_GATE_ENABLED=true
RERANK_SCORE_THRESHOLD=0.30

# ---- 改写可复现（评估可比性的前提）----
# 关键词抽取必须零温：0.3 会让同一问题每次改写都不同，指标因此不可复现
REWRITE_TEMPERATURE=0.0
REWRITE_MAX_CHARS=120
# 改写结果落盘复用，跨进程 / 跨运行拿到逐字相同的 query
REWRITE_CACHE_ENABLED=true
REWRITE_CACHE_PATH=data/cache/rewrite_cache.json
REWRITE_CACHE_MAX_ENTRIES=5000

# ---- 规则门：会话语短路，不做检索 ----
INTENT_GATE_ENABLED=true
INTENT_CHAT_MAX_CHARS=8

# ---- 阶段一：对话行为分流 ----
# 关掉后 dialogue_act 恒按 new_question 处理（完全复原还需一并回滚改写 Prompt）
DIALOGUE_ACT_ENABLED=true
# followup（指代追问）是否改用改写后的 query 打分
FOLLOWUP_SCORE_WITH_ENHANCED=true
# 自足问题（new_question）是否跳过改写、直接用原句检索
REWRITE_GATE_ON_ACT=true

# ---- 阶段二：检查点与人工澄清 ----
GRAPH_CHECKPOINTER_ENABLED=true
GRAPH_CHECKPOINTER_DB_PATH=data/cache/graph_checkpoints.sqlite
HUMAN_REVIEW_ENABLED=true
HUMAN_REVIEW_MAX_ROUNDS=1

# ---- 阶段三：指代消解（依赖 DIALOGUE_ACT_ENABLED）----
FOCUS_ENTITY_ENABLED=true

# ---- 阶段四：忠实性校验 ----
# L1：越界引用编号确定性剥除
GROUNDEDNESS_CITATION_CHECK=true
# L2：逐句忠实性核查（+1 次 LLM 调用 / 每次医学回答）。确认误报率可接受再开
GROUNDEDNESS_LLM_ENABLED=false

# ========== 服务 ==========
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# CORS 允许的前端地址
FRONTEND_URL=http://localhost:5173
